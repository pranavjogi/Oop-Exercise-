class Volume {

    double calculateVolume(double side) {
        return side * side * side;
    }

    double calculateVolume(double l, double w, double h) {
        return l * w * h;
    }

    double calculateVolume(double r, boolean sphere) {
        return (4.0 / 3.0) * Math.PI * r * r * r;
    }
}

public class pra12 {
    public static void main(String[] args) {

        Volume v = new Volume();

        double cube = v.calculateVolume(3);
        double cuboid = v.calculateVolume(4, 5, 6);
        double sphere = v.calculateVolume(3, true);

        System.out.println("Cube Volume: " + cube);
        System.out.println("Rectangular Cube Volume: " + cuboid);
        System.out.println("Sphere Volume: " + sphere);
    }
}
